{
  "description": "Patrones para detectar archivos y contenido sensibles. Se usa en guard-sensitive.sh",
  "patterns": [
    ".env(\\.local)?$",
    "\\.env\\..*",
    "id_rsa$",
    "id_ed25519$",
    "\\.pem$",
    "\\.key$",
    "\\.crt$",
    "\\.p12$",
    "\\.pfx$",
    "secrets\\.ya?ml$",
    "credentials\\.ya?ml$",
    ".*\\.secret$",
    ".*_secret$",
    ".*-secret$",
    "AWS_SECRET_ACCESS_KEY",
    "AWS_ACCESS_KEY_ID",
    "DATABASE_PASSWORD",
    "DB_PASSWORD",
    "JWT_SECRET",
    "SECRET_KEY",
    "API_KEY",
    "PRIVATE_KEY",
    "BEGIN (RSA|EC|OPENSSH) PRIVATE KEY",
    "password\\s*[=:]\\s*[\"'][^\"']{8,}[\"']",
    "token\\s*[=:]\\s*[\"'][^\"']{16,}[\"']",
    "Bearer\\s+[A-Za-z0-9\\-_=]+\\.[A-Za-z0-9\\-_=]+\\.[A-Za-z0-9\\-_=]+",
    "eyJ[A-Za-z0-9\\-_=]+\\.[A-Za-z0-9\\-_=]+\\.[A-Za-z0-9\\-_=]+",
    "-----BEGIN (RSA|EC|DSA|OPENSSH) PRIVATE KEY-----"
  ],
  "file_extensions": [
    ".env",
    ".env.local",
    ".env.production",
    ".env.staging",
    ".pem",
    ".key",
    ".crt",
    ".p12",
    ".pfx",
    ".secret"
  ],
  "filenames": [
    "id_rsa",
    "id_ed25519",
    "secrets.yml",
    "secrets.yaml",
    "credentials.yml",
    "credentials.yaml",
    ".htpasswd",
    ".htgroup"
  ],
  "environment_variables": [
    "PASSWORD",
    "SECRET",
    "TOKEN",
    "API_KEY",
    "PRIVATE_KEY",
    "ACCESS_KEY",
    "SECRET_KEY",
    "DATABASE_URL",
    "JWT_SECRET",
    "ENCRYPTION_KEY"
  ]
}