{
  "stacks": {
    "java-spring": {
      "name": "Java 21 + Spring Boot 3.x",
      "build_tools": {
        "maven": {
          "detect_files": ["pom.xml", "mvnw"],
          "test_command": "./mvnw verify",
          "lint_command": "./mvnw checkstyle:check spotbugs:check",
          "compile_command": "./mvnw compile",
          "coverage_tool": "jacoco",
          "coverage_min_line": 80,
          "coverage_min_branch": 70,
          "coverage_report_path": "target/site/jacoco/index.html"
        },
        "gradle": {
          "detect_files": ["build.gradle", "build.gradle.kts", "gradlew"],
          "test_command": "./gradlew check",
          "lint_command": "./gradlew checkstyleMain spotbugsMain",
          "compile_command": "./gradlew compileJava",
          "coverage_tool": "jacoco",
          "coverage_min_line": 80,
          "coverage_min_branch": 70,
          "coverage_report_path": "build/reports/jacoco/test/html/index.html"
        }
      },
      "skills": [
        "stack-java-spring",
        "spring-microservices-patterns",
        "api-design-review",
        "security-review-owasp",
        "db-migration-review",
        "test-strategy"
