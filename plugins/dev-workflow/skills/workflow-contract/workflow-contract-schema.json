{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/abelgomez/ai-dev-toolkit/plugins/dev-workflow/skills/workflow-contract/workflow-contract-schema.json",
  "title": "Dev Workflow Contract",
  "type": "object",
  "required": ["task_id", "stage", "status", "summary", "artifacts", "findings", "next_action"],
  "properties": {
    "task_id": {
      "type": "string",
      "format": "uuid",
      "description": "Identificador único de la tarea"
    },
    "stage": {
      "type": "string",
      "enum": ["architect", "implementer", "reviewer", "qa"],
      "description": "Etapa actual del flujo"
    },
    "status": {
      "type": "string",
      "enum": ["pending", "in_progress", "completed", "blocked", "rejected", "rejected_max_cycles"],
      "description": "Estado de la etapa actual"
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 500,
      "description": "Resumen ejecutivo de lo realizado en esta etapa"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "purpose", "status"],
        "properties": {
          "path": {"type": "string", "description": "Ruta del archivo relativa a la raíz del proyecto"},
          "purpose": {"type": "string", "description": "Propósito: created, modified, test, config, migration, doc"},
          "status": {"type": "string", "enum": ["pending", "completed", "failed"]}
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "rule", "file", "line", "description", "suggestion"],
        "properties": {
          "severity": {"type": "string", "enum": ["blocker", "major", "minor", "info"]},
          "rule": {"type": "string", "description": "Referencia exacta: skill-name regla N"},
          "file": {"type": "string"},
          "line": {"type": "integer", "minimum": 1},
          "description": {"type": "string"},
          "suggestion": {"type": "string"}
        }
      }
    },
    "next_action": {
      "type": "string",
      "enum": ["implement", "review", "qa", "replan", "done"],
      "description": "Próxima acción en el flujo"
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "verification_method", "verified"],
        "properties": {
          "id": {"type": "string"},
          "description": {"type": "string"},
          "verification_method": {"type": "string", "enum": ["unit_test", "integration_test", "contract_test", "e2e_test", "manual", "static_analysis"]},
          "verified": {"type": "boolean"}
        }
      }
    },
    "stack_detected": {"type": "string"},
    "skills_applicable": {"type": "array", "items": {"type": "string"}},
    "risk_assessment": {"type": "array", "items": {"type": "string"}},
    "steps_completed": {"type": "array", "items": {"type": "string"}},
    "deviations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["step_id", "reason", "impact"],
        "properties": {
          "step_id": {"type": "string"},
          "reason": {"type": "string"},
          "impact": {"type": "string", "enum": ["none", "low", "medium", "high"]}
        }
      }
    },
    "local_verification": {
      "type": "object",
      "properties": {
        "passed": {"type": "boolean"},
        "output": {"type": "string"},
        "command": {"type": "string"}
      }
    },
    "blockers_count": {"type": "integer", "minimum": 0},
    "majors_count": {"type": "integer", "minimum": 0},
    "minors_count": {"type": "integer", "minimum": 0},
    "decision": {
      "type": "object",
      "properties": {
        "decision": {"type": "string", "enum": ["approved", "rejected"]},
        "cycle": {"type": "integer", "minimum": 1, "maximum": 3},
        "verified_criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["criterion", "status", "evidence"],
            "properties": {
              "criterion": {"type": "string"},
              "status": {"type": "string", "enum": ["passed", "failed"]},
              "evidence": {"type": "string"}
            }
          }
        },
        "failed_criteria": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["criterion", "reason", "evidence"],
            "properties": {
              "criterion": {"type": "string"},
              "reason": {"type": "string"},
              "evidence": {"type": "string"}
            }
          }
        },
        "reviewer_findings_resolved": {"type": "boolean"},
        "test_results": {
          "type": "object",
          "properties": {
            "passed": {"type": "integer"},
            "failed": {"type": "integer"},
            "skipped": {"type": "integer"},
            "coverage": {"type": "string"}
          }
        },
        "notes": {"type": "string"}
      },
      "required": ["decision", "cycle", "verified_criteria", "failed_criteria", "reviewer_findings_resolved", "test_results"]
    }
  }
}